# ---- Data backend ----
# "memory" stores data in .data/db.json (local testing, no Google keys needed).
# "google" uses the real Google Sheet below.
DATA_BACKEND=memory

# ---- Google Sheets (Service Account) ----
GOOGLE_SERVICE_ACCOUNT_EMAIL=ads-hub@your-project.iam.gserviceaccount.com
# Paste the private key with literal \n for new lines, wrapped in double quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
SPREADSHEET_ID=your-spreadsheet-id

# ---- Sign in ----
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=change-me
# Emergency admin account. Use it for the first sign in, then create the real
# users from Settings > Users and roles. Pick a long password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- Site address ----
# The public address of the app, e.g. https://ads.qaswarah.com
# PDF reports open this address in a headless browser, so set it on Vercel.
APP_URL=http://localhost:3000
# Optional, local only: path to Chrome/Chromium for PDF export if it is not found automatically.
# CHROME_EXECUTABLE_PATH=
